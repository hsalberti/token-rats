{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main window of the Token Rats taskbar app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "store:default",
    "opener:default",
    "opener:allow-open-url",
    "autostart:default"
  ]
}
